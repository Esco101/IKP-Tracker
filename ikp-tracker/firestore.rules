rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'escoriyanto@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints (Verbatim synced with firebase-blueprint.json)
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidOperatorProfile(data) {
      return data.keys().hasAll([
          'uid',
          'operatorName',
          'expeditionId',
          'expeditionName',
          'shiftCode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'operatorName',
          'expeditionId',
          'expeditionName',
          'shiftCode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.operatorName is string && data.operatorName.size() >= 1 && data.operatorName.size() <= 80 &&
        data.expeditionId is string && data.expeditionId.size() >= 1 && data.expeditionId.size() <= 64 && data.expeditionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.expeditionName is string && data.expeditionName.size() >= 1 && data.expeditionName.size() <= 100 &&
        data.shiftCode is string && data.shiftCode.size() >= 1 && data.shiftCode.size() <= 32 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExpeditionConfig(data) {
      return data.keys().hasAll([
          'expeditionId',
          'name',
          'code',
          'username',
          'accessPin',
          'accountRole',
          'workspaceId',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'expeditionId',
          'name',
          'code',
          'username',
          'accessPin',
          'accountRole',
          'workspaceId',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.expeditionId is string && data.expeditionId.size() >= 1 && data.expeditionId.size() <= 64 && data.expeditionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 24 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.accessPin is string && data.accessPin.size() >= 1 && data.accessPin.size() <= 64 &&
        data.accountRole is string && data.accountRole.size() >= 5 && data.accountRole.size() <= 16 &&
        data.accountRole in ['EXPEDITION', 'OWNER'] &&
        data.workspaceId is string && data.workspaceId.size() == 13 && data.workspaceId == 'isuzu-yard-01' &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOutStockUnit(data) {
      return data.keys().hasAll([
          'vin',
          'vehicleType',
          'expeditionId',
          'expeditionName',
          'destination',
          'truckPlate',
          'driverName',
          'status',
          'notes',
          'workspaceId',
          'createdByUid',
          'operatorName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'vin',
          'vehicleType',
          'expeditionId',
          'expeditionName',
          'destination',
          'truckPlate',
          'driverName',
          'status',
          'notes',
          'workspaceId',
          'createdByUid',
          'operatorName',
          'createdAt',
          'updatedAt'
        ]) &&
        data.vin is string && data.vin.size() >= 5 && data.vin.size() <= 32 && data.vin.matches('^[A-Z0-9\\-]+$') &&
        data.vehicleType is string && data.vehicleType.size() >= 3 && data.vehicleType.size() <= 10 &&
        data.vehicleType in ['TRAGA', 'ELF', 'GIGA', 'D-MAX', 'MU-X'] &&
        data.expeditionId is string && data.expeditionId.size() >= 1 && data.expeditionId.size() <= 64 && data.expeditionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.expeditionName is string && data.expeditionName.size() >= 1 && data.expeditionName.size() <= 100 &&
        data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 120 &&
        data.truckPlate is string && data.truckPlate.size() >= 1 && data.truckPlate.size() <= 32 &&
        data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 80 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        data.status in ['STANDBY', 'OUT_GATE', 'IN_TRANSIT', 'DELIVERED'] &&
        data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 300 &&
        data.workspaceId is string && data.workspaceId.size() == 13 && data.workspaceId == 'isuzu-yard-01' &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.operatorName is string && data.operatorName.size() >= 1 && data.operatorName.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && adminId == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        adminId == request.auth.uid &&
        request.auth.token.email == 'escoriyanto@gmail.com' &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 5. Collection Rules: /operatorProfiles/{userId}
    match /operatorProfiles/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (userId == request.auth.uid || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(userId) && isValidOperatorProfile(incoming()) &&
        userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidOperatorProfile(incoming()) &&
        (userId == request.auth.uid || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'operatorName',
          'expeditionId',
          'expeditionName',
          'shiftCode',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // 6. Collection Rules: /expeditions/{expeditionId}
    match /expeditions/{expeditionId} {
      allow get: if isVerifiedUser() && isValidId(expeditionId) && (
        existing().createdByUid == request.auth.uid ||
        existing().workspaceId == 'isuzu-yard-01' ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().createdByUid == request.auth.uid ||
        existing().workspaceId == 'isuzu-yard-01'
      );

      allow create: if isVerifiedUser() && isValidId(expeditionId) && isValidExpeditionConfig(incoming()) &&
        incoming().expeditionId == expeditionId &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)).data.uid == request.auth.uid;

      allow update: if isVerifiedUser() && isValidId(expeditionId) && isValidExpeditionConfig(incoming()) &&
        incoming().expeditionId == existing().expeditionId &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().createdByUid == request.auth.uid &&
            exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid))
          )
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'code',
          'username',
          'accessPin',
          'accountRole',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() && isValidId(expeditionId) && (
        isAdmin() ||
        (
          existing().createdByUid == request.auth.uid &&
          exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid))
        )
      );
    }

    // 7. Collection Rules: /outStockUnits/{unitId}
    match /outStockUnits/{unitId} {
      allow get: if isVerifiedUser() && isValidId(unitId) && (
        existing().createdByUid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)).data.expeditionId == existing().expeditionId
        ) ||
        isAdmin()
      );

      // Cost-optimized list rule: zero get()/exists() calls, strictly enforces resource.data boundaries
      allow list: if isVerifiedUser() && (
        existing().createdByUid == request.auth.uid ||
        existing().workspaceId == 'isuzu-yard-01'
      );

      allow create: if isVerifiedUser() && isValidId(unitId) && isValidOutStockUnit(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)).data.uid == request.auth.uid;

      allow update: if isVerifiedUser() && isValidId(unitId) && isValidOutStockUnit(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().vin == existing().vin &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'vehicleType',
              'expeditionId',
              'expeditionName',
              'destination',
              'truckPlate',
              'driverName',
              'notes',
              'updatedAt'
            ])
          ) ||
          (
            existing().status != 'OUT_GATE' &&
            exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)) &&
            (
              existing().createdByUid == request.auth.uid ||
              get(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)).data.expeditionId == existing().expeditionId
            ) &&
            (
              // Action 1: Expedition mobile user marks unit Out Gate (stamps real-time updatedAt)
              (
                incoming().status == 'OUT_GATE' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
              ) ||
              // Action 2: Sync renamed expeditionName
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['expeditionName', 'updatedAt'])
              )
            )
          ) ||
          (
            // Action 3: Creator can rename expeditionName or reset status on their own workspace units
            existing().createdByUid == request.auth.uid &&
            exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'expeditionName',
              'notes',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(unitId) && (
        isAdmin() ||
        (
          existing().createdByUid == request.auth.uid &&
          exists(/databases/$(database)/documents/operatorProfiles/$(request.auth.uid))
        )
      );
    }
  }
}
